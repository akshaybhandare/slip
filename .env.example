# ==============================================================================
# Slip - Environment Configuration
# ==============================================================================

# Port on your host machine to access Slip (e.g. http://<IP>:3080)
HOST_PORT=3080

# Internal application port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production

# Server bind address
HOST=0.0.0.0

# Persistent database path on host/container
DB_PATH=/config/bookmarks.db

# Cache directory for thumbnails and screenshots
CACHE_DIR=/config/cache

# Unraid user & group permissions (99: nobody, 100: users)
PUID=99
PGID=100

# Set to true if hosting behind an HTTPS reverse proxy (Traefik, Nginx, Caddy)
COOKIE_SECURE=false
